# 复制为 .env.local。每位用户的 DeepSeek Key 在网页中自行填写，服务器不保存。

# 可选：返回审核 TrainingPack JSON 的 HTTPS 地址。未配置时只使用内置题包。
PRACTICE_FEED_URL=

# Supabase 前端公开连接信息：在 Project Settings > API 复制。
# 可放入前端；绝不能填 service_role / secret key。
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Pages Functions 使用这两个变量验证登录用户；值与上面两项相同。
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
